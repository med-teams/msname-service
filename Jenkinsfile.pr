pipeline {
    agent any

    tools {
        maven 'Maven-3.9' // Assurez-vous que le nom correspond à votre config Jenkins (Manage Jenkins > Tools)
    }

    stages {
        stage('Compile & Test') {
            steps {
                sh 'mvn clean test'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def scannerHome = tool 'SonarQubeScanner' // Si vous utilisez le scanner global ou Maven directement
                    withSonarQubeEnv('SonarQube') { // Nom défini dans Manage Jenkins > System
                        sh 'mvn sonar:sonar -Dsonar.projectKey=msname-service'
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    // Bloque la PR si SonarQube renvoie FAIL
                    waitForQualityGate abortPipeline: true
                }
            }
        }
    }
}
