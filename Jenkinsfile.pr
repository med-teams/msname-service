pipeline {
    agent any

    tools {
        maven 'Maven-3.9'
    }

    stages {

        stage('Debug PR') {
            steps {
                sh '''
                    echo "CHANGE_ID=$CHANGE_ID"
                    echo "CHANGE_BRANCH=$CHANGE_BRANCH"
                    echo "CHANGE_TARGET=$CHANGE_TARGET"
                '''
            }
        }

        stage('1. Build & Push Commons-API') {
            steps {
                configFileProvider([
                        configFile(
                                fileId: 'maven-nexus-settings',
                                variable: 'MAVEN_SETTINGS'
                        )
                ]) {
                    dir('commons-api-temp') {
                        git branch: 'main',
                                url: 'https://github.com/med-teams/commons-api.git'

                        sh 'mvn clean deploy -s $MAVEN_SETTINGS'
                    }
                }
            }
        }

        stage('2. Compile & Test MS Name Service') {
            steps {
                configFileProvider([
                        configFile(
                                fileId: 'maven-nexus-settings',
                                variable: 'MAVEN_SETTINGS'
                        )
                ]) {
                    sh 'mvn clean verify -s $MAVEN_SETTINGS'
                }
            }
        }

        stage('3. SonarQube Analysis') {
            steps {
                configFileProvider([
                        configFile(
                                fileId: 'maven-nexus-settings',
                                variable: 'MAVEN_SETTINGS'
                        )
                ]) {
                    withSonarQubeEnv('SonarQube') {
                        sh '''
                            echo "=============================="
                            echo "Analyse SonarQube du PR"
                            echo "PR       : $CHANGE_ID"
                            echo "Source   : $CHANGE_BRANCH"
                            echo "Target   : $CHANGE_TARGET"
                            echo "=============================="

                            mvn sonar:sonar \
                              -Dsonar.projectKey=msname-service \
                              -Dsonar.projectName=msname-service \
                              -Dsonar.pullrequest.key="$CHANGE_ID" \
                              -Dsonar.pullrequest.branch="$CHANGE_BRANCH" \
                              -Dsonar.pullrequest.base="$CHANGE_TARGET" \
                              -s "$MAVEN_SETTINGS"
                        '''
                    }
                }
            }
        }

        stage('4. Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
    }
}